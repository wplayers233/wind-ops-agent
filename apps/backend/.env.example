# Core chat model
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Multimodal ingestion providers (OpenAI-compatible)
OCR_BASE_URL=
OCR_API_KEY=
OCR_MODEL=dots-ocr
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=qwen3-vl
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_FALLBACK_DIMENSIONS=64
BGE_RERANKER_MODEL=

# Storage
REDIS_URL=redis://localhost:6379/0
MILVUS_URI=http://localhost:19530
MEMORY_REMOTE_ENABLED=false
MEMORY_DISTANCE_THRESHOLD=0.65

# Evaluation
RAGAS_ENABLED=false